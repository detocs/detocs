{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "build",
    "target": "ES2019",
    "noEmit": true,
    "module": "node18",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@desktop/*": [ "./src/desktop/*" ],
      "@export/*": [ "./src/export/*" ],
      "@import/*": [ "./src/import/*" ],
      "@models/*": [ "./src/models/*" ],
      "@server/*": [ "./src/server/*" ],
      "@services/*": [ "./src/services/*" ],
      "@upload/*": [ "./src/upload/*" ],
      "@util/*": [ "./src/util/*" ],
      "@web/*": [ "./src/web/*" ],
      "package.json": [ "./package.json" ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h"
  },
  "include": [ "src/" ]
}
